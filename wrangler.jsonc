{
	// Cloudflare Workers with static assets: serves the built site in dist/ and nothing else.
	// The app uses hash routes and relative URLs, so no server-side routing is needed.
	// Build with `npm run build`; deploy with `npx wrangler deploy`.
	"name": "eviota",
	"compatibility_date": "2025-06-05",
	"assets": { "directory": "./dist" }
}
