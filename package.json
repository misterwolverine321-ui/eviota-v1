{
  "name": "eviota",
  "version": "1.0.0",
  "description": "A private reader for the files other readers struggle with. Runs entirely in the browser.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test -c playwright.webkit.config.ts",
    "bench": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "verify:static": "node scripts/verify-static.mjs",
    "notices": "node scripts/make-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "djvu-rs": "0.43.0",
    "fflate": "^0.8.3",
    "foliate-js": "^1.0.1",
    "idb": "^8.0.4",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.149",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
